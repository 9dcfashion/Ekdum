# ── Supabase (Project Settings → API). Region: Mumbai (ap-south-1) ────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. Safe for the browser; RLS is the guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for invoice links, invites, sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for /api/jobs/notifications (send as "Authorization: Bearer …").
# Generate with: openssl rand -hex 32
JOBS_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# mock = log to the server console (default). resend = send through Resend.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# e.g. "EkDum <bills@yourdomain.in>". The domain must be verified in Resend.
EMAIL_FROM=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# mock = log to the server console (default). meta = WhatsApp Cloud API.
# evolution = self-hosted Evolution API gateway (no Meta template needed).
WHATSAPP_PROVIDER=mock
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_INVOICE_TEMPLATE_NAME=
META_WA_TEMPLATE_LANGUAGE=en
# Optional. Graph API version for the WhatsApp Cloud API (default v23.0).
META_GRAPH_VERSION=
# Evolution API (WHATSAPP_PROVIDER=evolution). Server only; never prefix with NEXT_PUBLIC_.
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
# The instance's own token (preferred over the global key: it only works for this instance).
EVOLUTION_API_KEY=

# ── Offline POS ──────────────────────────────────────────────────────────────
# The service worker registers only in production builds.
# Set to "on" to try it in dev, or "off" to disable it everywhere.
NEXT_PUBLIC_SW=
